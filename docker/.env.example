# Copy to .env and fill in. .env is gitignored — never commit the real key.
#
# Generate a key:
#   openssl rand -base64 36
#
# This is the MASTER key: it grants read AND write on every index. It stays on
# the server, shared only between this container and the two things that talk to
# it (the deploy-time push script and the NLM servlet). It must never appear in
# a browser bundle. Because NLM proxies all queries, no search-only key is
# needed either — nothing client-side ever authenticates to Meilisearch.
MEILI_MASTER_KEY=
